{
  "name": "ip2ldb-reader",
  "version": "6.0.0",
  "description": "Reader for IP2Location databases",
  "type": "module",
  "main": "./lib/index.js",
  "exports": "./lib/index.js",
  "scripts": {
    "build": "npm run check-types && npm run check-formatting && npm run lint && npm run compile && publint",
    "clean": "rimraf lib",
    "cli": "node lib/cli.js",
    "cli:debug": "tsx src/cli.ts",
    "compile": "npm run clean && tsc -p tsconfig.build.json",
    "compile:debug": "npm run clean && tsc --sourceMap",
    "check-formatting": "oxfmt --check",
    "check-types": "tsc --noEmit && tsc --noEmit -p tests",
    "format": "oxfmt",
    "lint": "oxlint",
    "prepare": "npm run compile",
    "test": "vitest"
  },
  "engines": {
    "node": ">= 22.12.0"
  },
  "files": [
    "/lib"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdmower/ip2ldb-reader.git"
  },
  "keywords": [
    "ip2location",
    "geolocation"
  ],
  "author": "Matt Mower <mdmower@cmphys.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mdmower/ip2ldb-reader/issues"
  },
  "homepage": "https://github.com/mdmower/ip2ldb-reader#readme",
  "allowScripts": {
    "esbuild": true
  },
  "dependencies": {
    "csv-parse": "^7.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "oxlint-tsgolint": "^7.0.2008",
    "publint": "^0.3.25",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
